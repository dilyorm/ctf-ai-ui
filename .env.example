# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# GitHub OAuth (for the web UI dashboard)
# Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Web UI settings
UI_SECRET_KEY=change-me-to-a-random-secret
APP_SECRET_KEY=change-me-to-a-long-random-secret
UI_HOST=0.0.0.0
UI_PORT=8080

# Admin bootstrap — creates an admin on first startup if no admin exists.
# (Safe to leave set; it's a no-op once any admin account is present.)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Postgres (local dev defaults)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ctf_agent
POSTGRES_USER=ctf_agent
POSTGRES_PASSWORD=ctf_agent
